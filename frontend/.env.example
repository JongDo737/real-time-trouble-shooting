PORT=8080
# Same-origin paths when accessing the app through nginx.
# For standalone frontend access, set browser-accessible backend addresses instead.
API_BASE_URL=/backend/api/
WS_BASE_URL=/backend/ws/
STT_URL=/voice/stt/
# UI preview role only; live role comes from the login response.
MOCK_ROLE=AGENT
# Development-only screen preview; never authenticates or performs requests.
ENABLE_UI_PREVIEW=false
