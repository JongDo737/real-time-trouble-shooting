PORT=8080
# Browser-accessible addresses; not Docker service names.
# Examples only: http://realshoot/backend/api/ and ws://realshoot/backend/ws/
API_BASE_URL=
WS_BASE_URL=
# UI preview role only; live role comes from the login response.
MOCK_ROLE=AGENT
# Development-only screen preview; never authenticates or performs requests.
ENABLE_UI_PREVIEW=false
